generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SCHOOL
  INTERVENANT
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  role      Role
  createdAt DateTime @default(now())

  school      School?
  intervenant Intervenant?
}

model School {
  id          String @id @default(cuid())
  city        String
  postalCode  String
  managerName String
  managerRole String

  userId   String    @unique
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  demandes Demande[]
}

model Intervenant {
  id        String @id @default(cuid())
  firstname String
  lastname  String
  expertise String
  linkedin  String

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Demande {
  id    String @id @default(cuid())
  theme String

  description String
  date        String?
  duration    String?
  level       String?

  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  createdAt DateTime @default(now())
}
